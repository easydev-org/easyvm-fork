walkthrough "macos 26 ssh - the setup assistant, remote login, and a graceful shutdown"
  resolution 1920x1080
  user vmuser
  # `vmuser` IS THE USER NAME, NOT A PASSWORD, AND IT WAS IN THIS SLOT AS BOTH.
  #
  # `{{ password }}` is typed into the account's password field (line ~18's `account password text`)
  # and into the login window, so a value equal to the account name would be typed as its own
  # password. macos/15's ssh walk, which RUNS AND PASSES, uses `admin`.
  password admin
  var out == {default: out/macos26-ssh.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header boot_disk == from_caller
  header recording_resolution == [1920, 1080]
  header ssh_port == 2222

  needs boot.img macos.rom macos.vars, named "the media this stage boots from is already on disk"
  step "boot the disk"
    boot == true
    memory_mb == 12288
    os == macos
    timeout == 900
  step "answer the wizard until the desktop appears"
    loop == {check: {from: wizard, mode: text, name: finished, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, without: [continue, back, later], words: [finder]}, do: [{name: "read the pane", see: {name: pane}}, {name: "read the login window's clock", see: {name: clock}}, {check: {from: clock, mode: matches, name: at_login, pattern: "[0-9]+[:.][0-9]+", rect: [820, 90, 1100, 250], rect_at: [1920, 1080], scale: 1}, name: "classify - the login window"}, {check: {from: pane, mode: text, name: country, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[select, your, country, or, region]]}, name: "classify - country or region"}, {check: {from: pane, mode: text, name: transfer, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[transfer, your, information, to, this, mac]]}, name: "classify - transfer"}, {check: {from: pane, mode: text, name: account, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[create, a, mac, account]]}, name: "classify - account"}, {check: {from: pane, mode: text, name: apple_account, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[sign, in, to, your, apple, account]]}, name: "classify - apple account"}, {check: {from: pane, mode: text, name: apple_sheet, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[sure, skip, signing]]}, name: "classify - the apple account sheet"}, {check: {from: pane, mode: text, name: terms, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[terms, conditions]]}, name: "classify - terms"}, {check: {from: pane, mode: text, name: age, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[age, range]]}, name: "classify - age"}, {check: {from: pane, mode: text, name: location, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[enable, location, services]]}, name: "classify - location"}, {check: {from: pane, mode: text, name: location_sheet, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[find, my, available]]}, name: "classify - the location sheet"}, {check: {from: pane, mode: text, name: time_zone, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[time, zone]]}, name: "classify - time zone"}, {check: {from: pane, mode: text, name: analytics, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[share, analytics, with, apple]]}, name: "classify - analytics"}, {check: {from: pane, mode: text, name: privacy_pane, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[privacy, fundamental]]}, name: "classify - data and privacy"}, {check: {from: pane, mode: text, name: languages, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[spoken, languages]]}, name: "classify - spoken languages"}, {check: {from: pane, mode: text, name: accessibility, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[accessibility, individual]]}, name: "classify - accessibility"}, {check: {from: pane, mode: text, name: screen_time, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[screen, time]]}, name: "classify - screen time"}, {check: {from: pane, mode: text, name: filevault, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[ready, encrypting]]}, name: "classify - filevault"}, {check: {from: pane, mode: text, name: filevault_sheet, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[securely, encrypted]]}, name: "classify - the filevault sheet"}, {check: {from: pane, mode: text, name: look, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[choose, your, look]]}, name: "classify - look"}, {check: {from: pane, mode: text, name: update, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[update, mac, automatically]]}, name: "classify - update"}, {check: {from: pane, mode: text, name: keyboard, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[keyboard, assistant]]}, name: "classify - keyboard"}, {if: languages, name: "spoken languages", then: [{click: [1284, 799], name: "languages continue", settle: 7}]}, {if: accessibility, name: accessibility, then: [{click: [1284, 799], name: "accessibility not now", settle: 7}]}, {if: privacy_pane, name: "data and privacy", then: [{click: [1284, 799], name: "privacy continue", settle: 8}]}, {if: transfer, name: "transfer your data", then: [{click: [742, 712], name: "choose not to transfer", settle: 3}, {click: [1284, 799], name: "transfer continue", settle: 8}]}, {if: country, name: "country or region", then: [{click: [900, 470], name: "focus the country list", settle: 2}, {name: "type the country", settle: 3, type: "united states"}, {click: [1284, 799], name: "country continue", settle: 7}]}, {if: account, name: "the account, which is what this whole stage exists for", then: [{click: [959, 496], name: "account full name", settle: 2}, {name: "account full name text", settle: 2, type: "{{ user }}"}, {click: [959, 530], name: "account short name", settle: 2}, {key: meta_l+a, name: "clear the auto-filled short name", settle: 1}, {key: backspace, name: "delete it", settle: 1}, {name: "account short name text", settle: 2, type: "{{ user }}"}, {click: [841, 601], name: "account password", settle: 2}, {name: "account password text", settle: 2, type: "{{ password }}"}, {click: [1068, 601], name: "account verify", settle: 2}, {name: "account verify text", settle: 2, type: "{{ password }}"}, {click: [745, 663], name: "untick the apple account reset", settle: 2}, {click: [1284, 799], name: "account continue", settle: 180}]}, {if: apple_account, name: "apple account - other sign-in options, then later", then: [{click: [620, 800], name: "open other sign-in options", settle: 4}, {click: [682, 853], name: "sign in later", settle: 7}]}, {if: apple_sheet, name: "the apple account confirmation sheet", then: [{click: [1017, 644], name: "skip the apple account", settle: 8}]}, {if: terms, name: "terms and conditions", then: [{click: [1282, 799], name: "terms agree", settle: 7}, {click: [1019, 616], name: "licence agree", settle: 8}]}, {if: age, name: "age range", then: [{click: [959, 710], name: "choose adult", settle: 7}]}, {if: location, name: "location services", then: [{click: [1284, 799], name: "location continue", settle: 7}]}, {if: location_sheet, name: "the location confirmation sheet", then: [{click: [959, 575], name: "dont use location services", settle: 7}]}, {if: time_zone, name: "time zone", then: [{click: [1284, 799], name: "time zone continue", settle: 7}]}, {if: analytics, name: "analytics - untick sharing first", then: [{click: [745, 520], name: "untick share analytics", settle: 2}, {click: [1284, 799], name: "analytics continue", settle: 7}]}, {if: screen_time, name: "screen time", then: [{click: [1131, 799], name: "screen time later", settle: 7}]}, {if: filevault, name: filevault, then: [{click: [1129, 799], name: "filevault not now", settle: 8}]}, {if: filevault_sheet, name: "the filevault confirmation sheet", then: [{click: [1004, 598], name: "continue without filevault", settle: 8}]}, {if: look, name: "choose your look", then: [{click: [1284, 799], name: "look continue", settle: 9}]}, {if: keyboard, name: "the keyboard assistant, which eats the next keystroke", then: [{click: [1228, 826], name: "keyboard quit", settle: 10}]}, {if: update, name: "update mac automatically - reset past it", then: [{acpi: reset, name: "reset the guest", timeout: 300}, {name: "let it come back", settle: 60}]}, {if: at_login, name: "the login window - log in", then: [{click: [960, 983], name: "click the password field", settle: 3}, {name: "type the password", settle: 2, type: "{{ password }}"}, {key: ret, name: "press return", settle: 25}]}], max: 90, see: {name: wizard}, until: {fact: finished}}
  step "wait for the desktop"
    loop == {check: {from: desk, mode: text, name: ready, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, without: [continue, back, later], words: [finder]}, do: [{settle: 10}, {key: esc}], max: 30, see: {name: desk}, until: {fact: ready}}
  press Escape, waiting 2s, named "dismiss anything over the desktop"
  press meta_l+spc, waiting 4s, named "open spotlight"
  step "type the settings app name"
    settle == 7
    type == system settings
  press Return, waiting 14s, named "open it"
  step "the settings window is up"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[system, settings], [general], [wi-fi]]}, do: [{settle: 3}], max: 30, see: {name: screen}, until: {fact: done}}
  # THE SEARCH FIELD IS REACHED WITH Cmd+F, NOT WITH A COORDINATE.
  #
  # MEASURED on run 44838865799, whose recording ends with the field EMPTY and the sidebar showing the
  # full list (General, Displays, Spotlight, Wallpaper, ...) while `Game Center` is highlighted:
  #
  #	see: 29 word(s): @ Displays Spotlight «3 Wallpaper O sir Q Notifications 4°) Sound Focus ...
  #	the remote login result is on screen [check]: done = false (none of "sharing" in ...)
  #
  # The click at [715, 267] landed on nothing. That coordinate was measured on an earlier frame, and
  # the settings window does not open at a fixed position - in this run its search field was at
  # y 323 and the click went above it, into the title bar. THE COORDINATE WAS THE BUG.
  #
  # Cmd+F IS SYSTEM SETTINGS' OWN "FIND" and does not depend on where the window is. And the
  # Keyboard Setup Assistant was still on screen behind it, so the first thing typed could be eaten:
  # `type` is retried once the field is open and the assistant closed.
  step "close the keyboard assistant, if it is still up"
    loop == {check: {from: screen, mode: text, name: up, rect: [560, 200, 1400, 300], rect_at: [1920, 1080], scale: 1, words: [[keyboard, setup]]}, do: [{click: [666, 259], settle: 3}], max: 3, see: {name: screen}, until: {fact: up}}
    optional == true
  # THE SEARCH FIELD IS CLICKED FIRST AND `Cmd+F` IS ONLY THE FALLBACK, BECAUSE `Cmd+F` ALONE HAS
  # BEEN MEASURED NOT TO WORK ON THIS IMAGE.
  #
  # MEASURED on run 44895802436: `Cmd+F` then `type remote login`, and the pane came out as
  #
  #	see: 40 word(s): < > | General Manage your overall setup and preferences for Mac, ...
  #
  # - General, with the sidebar's full list and an EMPTY search field. The keystrokes went nowhere.
  # macOS 15's stage reaches this field with a CLICK at (715, 267) and a `meta_l` modifier, and that
  # image's search does work; this one opens its window at a slightly different height, so the click
  # is made at the field's own centre and `Cmd+F` is pressed afterwards - one of the two focuses it,
  # and the check below proves which.
  step "click the settings search field"
    clear == true
    click == [715, 323]
    settle == 3
  step "and ask the keyboard to focus it too, if the click missed"
    key == meta_l+f
    settle == 4
  step "search for remote login"
    type == remote login
  # THE SEARCH IS PROVEN BY ITS RESULT, NOT ASSUMED. A field that never took the text leaves the
  # sidebar showing General/Displays/Wallpaper, and the pane step then fails several steps later with
  # a message about a pane - which is five measurements away from "the typing went nowhere".
  step "the search found something"
    # THE WORDS ARE WHAT THE READER RETURNS. MEASURED on run 44899803256, where the search DID work:
    #
    #	the search found something [check]: found = false (none of "sharing" in "O Remo Remot comp!")
    #
    # `O Remo Remot comp!` is the sidebar with both results in it - `Sharing` and `Remote login`, each
    # clipped by the 2x upscale. The search was fine; the check demanded a word the reader had already
    # lost the middle of.
    #
    # `remote` IS in that string and is the word that matters: this stage is looking for the Remote
    # login result, and a sidebar showing it cannot show it without that substring. The scale is 1 so
    # the reader gets whole lines rather than a magnified fragment.
    # THE FIELD, NOT THE LIST, AND THE DIFFERENCE IS MEASURED. On run 44905549978's final frame the
    # Remote Login panel is OPEN and the sidebar behind it is covered:
    #
    #	[615, 262, 800, 285]  ->  "Q. remote login"     THE FIELD, with the text in it
    #	[610, 250, 830, 420]  ->  ""                    the list, covered by the panel
    #
    # So a check on the list fails exactly when the stage is doing well - and that is the wrong way
    # round for a gate. What this step has to establish is "the text reached the field", and the field
    # says so whether or not a panel is over the list.
    loop == {check: {from: screen, mode: text, name: found, rect: [615, 262, 800, 285], rect_at: [1920, 1080], scale: 1, words: [[remote]]}, do: [{click: [715, 323], settle: 2}, {type: remote login, settle: 3}], max: 4, see: {name: screen}, until: {fact: found}}
  # THE SEARCH NEEDS A RETURN, AND THE RESULT LIST IS EMPTY WITHOUT ONE.
  #
  # MEASURED on run 44830318447, whose recording ends on System Settings with `remote login` typed in
  # the search field and NOTHING in the sidebar but a gear glyph - and whose log shows the check
  # reading one character, `b`, twenty-one times in a row:
  #
  #	see: 1 word(s): b
  #
  # The words were in the field and the search had not run. A Return submits it; without one the
  # sidebar stays empty for ever, and the check's rectangle - which frames the RESULT, not the field -
  # reads whatever the wallpaper is showing through the empty list.
  press Return, waiting 4s, named "run the search"
  step "the remote login result is on screen"
    # THE RECT IS THE SIDEBAR ROW, MEASURED FROM THE FRAME: the result that appears after a successful
    # search sits at x 615..800, y 265..330. The old box, [480, 240, 760, 420], covers the sidebar's
    # empty top half plus a strip of desktop on its left.
    # THE WHOLE SIDEBAR, BECAUSE THE RESULT'S ROW MOVES WITH THE WINDOW'S SCROLL AND THE SEARCH
    # FIELD'S HEIGHT. What has to be true is "a result named Sharing is in the list", and a rectangle
    # that frames the list is the honest way to ask that.
    loop == {check: {from: screen, mode: text, name: done, rect: [610, 250, 830, 780], rect_at: [1920, 1080], scale: 2, words: [[sharing]]}, do: [{settle: 3}], max: 20, see: {name: screen}, until: {fact: done}}
  # THE RESULT IS TWO ROWS UNDER A HEADING, AND [703, 336] LANDED BETWEEN THEM.
  #
  # MEASURED on run 44846410525's recording, whose search DID work after `Cmd+F`:
  #
  #	[ remote login            ]
  #	⚙ Sharing                 <- the group heading, y ~364
  #	    Remote login          <- THE RESULT,        y ~392
  #
  # The click at (703, 336) was above the heading, on the empty strip between the search field and the
  # list, so the window stayed on General - and the next check, which looks for the pane's own
  # "Allow full disk access" row, spent its whole budget describing General.
  # THE PANE IS OPENED IN A LOOP, BECAUSE ONE CLICK SELECTS AND ONLY THE PANE'S CONTENTS PROVE IT.
  #
  # MEASURED on run 44860489305: one click leaves the row HIGHLIGHTED and the right-hand side still
  # saying General. MEASURED on run 44865551562: a DOUBLE click leaves the same thing. Both were
  # single gestures with a fixed wait, and both were wrong about how this list opens.
  #
  # SO THE GESTURE IS REPEATED UNTIL THE PANE'S OWN WORDS ARE ON SCREEN, and the loop's condition is
  # the CONTENT rather than the highlight: "Allow full disk access" is a row inside the pane and
  # appears nowhere else, so it cannot be satisfied by a selected list row.
  #
  # `max: 4` because a list that ignores four clicks is not going to answer a fifth; each attempt
  # clicks the row and waits for the pane to draw.
  # SELECTING "REMOTE LOGIN" OPENS THE SHARING OVERVIEW, NOT A REMOTE-LOGIN PANE.
  #
  # MEASURED on run 44877397659's recording, whose last ten minutes are this:
  #
  #	[ remote login ]        <- the sidebar row, HIGHLIGHTED blue
  #	                        Sharing
  #	                        Content & Media
  #	                          File Sharing          [ off ]
  #	                          Media Sharing         [ off ]
  #	                          Screen Sharing        [ off ]
  #	                          Content Caching       [ off ]
  #	                        Accessories & Internet
  #	                          Bluetooth / Printer / Internet Sharing
  #	                        Advanced
  #	                          Remote Management     [ off ]
  #
  # - the row IS selected and the pane IS "Sharing", but Remote Login is further down that list, out of
  # view. The previous check demanded "access for remote users", which is a row of the REMOTE LOGIN
  # section, so it read the overview as "the pane never opened" and clicked the sidebar four times.
  #
  # SO THE CHECK ASKS FOR THE OVERVIEW BY ITS OWN HEADING, and the list is then scrolled to the bottom
  # where Remote Login lives. `content & media` appears on this page and nowhere else in Settings.
  # THE SIDEBAR ROW SCROLLS THE RIGHT-HAND PAGE TO ITS OWN SECTION; IT DOES NOT OPEN A NEW PAGE.
  #
  # MEASURED on run 44947726644's final frame, with `Remote login` HIGHLIGHTED blue in the sidebar and
  # the pointer resting on it:
  #
  #	Sharing
  #	  Content & Media        File / Media / Screen Sharing, Content Caching
  #	  Accessories & Internet Bluetooth / Printer / Internet Sharing
  #	  Advanced               Remote Management
  #
  # and the page's SCROLLBAR still at the TOP. THAT IS WHY EVERY CLICK "DID NOTHING": the row was
  # accepted, and the section it points at is BELOW THE FOLD of one long page. The one run that
  # appeared to work (44884134179, "Login: oft ... rising SSH ond SFTP") had scrolled there.
  #
  # SO THE SELECTION IS FOLLOWED BY A SCROLL. The focus is moved into the detail pane first - a key
  # sent while the sidebar has it scrolls the sidebar - and then Page Down walks the page until Remote
  # Login's own sentence is on screen.
  # REMOTE LOGIN IS A ROW INSIDE THE SHARING PAGE, NOT A PAGE OF ITS OWN.
  #
  # MEASURED on run 44959875619's final frame - the first picture of the BOTTOM of this page, after
  # clicking the scrollbar track finally moved it:
  #
  #	Accessories & Internet
  #	    Bluetooth Sharing              [ off ] (i)
  #	    Printer Sharing                [ off ] (i)
  #	    Internet Sharing               [ off ] (i)
  #	Advanced
  #	    Remote Management              [ off ] (i)
  #	    Remote Login                   [ off ] (i)      <- THE SWITCH THIS STAGE NEEDS
  #	    Remote Application Scripting   [ off ] (i)
  #	Local hostname   vmusers-iMac.local        [ Edit... ]
  #	Computers on your local network can access your computer at this address.
  #
  # EVERY EARLIER VERSION LOOKED FOR "using SSH and SFTP" - the sentence that appears once the switch
  # is ON, or in the (i) popover. That is the SAME MISTAKE AS THE PANE ITSELF: a check that can only
  # pass after the action it is checking. So the stage was scrolling past the row it needed while
  # waiting for proof that it had already been clicked.
  #
  # THE SWITCH IS AT (1243, 585) ON THAT FRAME, found by scanning its own track: a white knob
  # (255,255,255) at x 1228..1246 and a grey track (216..222) at x 1248..1260, i.e. OFF. Its row's
  # label reads "Remote Login" in OCR.
  step "select the remote login row"
    click == [703, 340]
    settle == 4
  # THE BOTTOM OF THE PAGE IS THE PLACE TO AIM FOR, AND `Advanced` + `Local hostname` ARE ITS OWN
  # WORDS - both appear only at the very bottom, and neither is a sentence that depends on the switch.
  step "page the sharing list to its bottom"
    loop == {check: {from: screen, mode: text, name: bottom, rect: [840, 250, 1300, 800], rect_at: [1920, 1080], scale: 1, words: [[advanced], [local, hostname]]}, do: [{click: [1311, 720], settle: 3}], max: 10, see: {name: screen}, until: {fact: bottom}}
  # THE ROW IS CLICKED BY ITS LABEL FIRST, so a mis-measured switch cannot silently click the
  # neighbouring `Remote Management` row: the check below proves the LABEL is where the click will go.
  step "the remote login row is in view"
    loop == {check: {from: screen, mode: text, name: row, rect: [900, 545, 1200, 620], rect_at: [1920, 1080], scale: 1, words: [[remote, login]]}, do: [{settle: 2}], max: 3, see: {name: screen}, until: {fact: row}}
  # THE SWITCH ITSELF, AT THE ROW'S RIGHT-HAND END.
  #
  # MEASURED from the same frame by scanning the track: the knob is white (255,255,255) at
  # x 1228..1246 and the track is grey (216..222) at x 1248..1260, all of it inside y 579..591. So the
  # control's centre is (1243, 585) and its left-hand state means OFF.
  #
  # IT IS CLICKED ONCE. A retry loop here would toggle it back - the page redraws under the pointer and
  # a second click lands on a switch that is now ON.
  step "turn remote login on"
    click == [1243, 585]
    settle == 6
  # TURNING REMOTE LOGIN ON RAISES AN AUTHORISATION DIALOG, AND THE OLD STEPS WALKED PAST IT.
  #
  # MEASURED on run 44679850735's recording, whose last fifty minutes are this one screen:
  #
  #	Sharing
  #	Remote Login is trying to modify system settings.
  #	Enter your password to allow this.
  #
  #	[ vmuser  ]
  #	[ Password ]          <- the cursor is here
  #	[ Modify Settings ]   [ Cancel ]
  #
  # Clicking the switch does nothing until that dialog is answered, so the switch stayed off, sshd
  # never started, and `wait for sshd` spent its ten minutes on a closed port. The two steps that
  # followed were waiting for the words "log in to this computer" - which is what macOS 15's Remote
  # Login pane says once the switch is ON. This image says it differently, so the check could never
  # pass and the loop ran its whole budget.
  #
  # SO THE DIALOG IS ANSWERED, and the question "did it work" is asked of the SWITCH rather than of a
  # sentence: after the dialog is accepted the pane shows the remote-login status line, and the old
  # phrase is kept as an OR because that is what a 15-style pane would show.
  step "the authorisation dialog is up, if this pane asks for one"
    loop == {check: {from: screen, mode: text, name: asked, rect: [830, 380, 1200, 730], rect_at: [1920, 1080], scale: 2, words: [[remote, login, is, trying, to, modify]]}, do: [{settle: 2}], max: 6, see: {name: screen}, until: {fact: asked}}
    optional == true
  # THE COORDINATES ARE MEASURED FROM THE DIALOG ITSELF, NOT FROM ITS SHAPE.
  #
  # From run 44679850735's frame, scanning the pixel colour of the accent button:
  #
  #	Password field    y 575..590    (the box above the buttons)
  #	accent blue       y 620..645    (0,122,255) - that is `Modify Settings`, the default button
  #	Cancel            y 650..660
  # THE DIALOG'S PASSWORD FIELD ARRIVES FOCUSED, SO NOTHING IS CLICKED INTO IT.
  #
  # MEASURED on run 44679850735's frame: the sheet is
  #
  #	Remote Login is trying to modify system settings.
  #	Enter your password to allow this.
  #	[ vmuser                 ]
  #	[ Password               ]   <- the insertion point is already here
  #	[ Modify Settings ]  [ Cancel ]
  #
  # and `Modify Settings` is the ACCENT-BLUE default button (0,122,255). A default button answers
  # Return. So the sheet is answered by typing the password and pressing Return - two actions that do
  # not depend on where the window is, which matters because this window is NOT maximised and its
  # origin shifts between runs.
  step "type the password into the dialog"
    when == [asked]
    type == '{{ password }}'
    type_gap == 0.10
    settle == 2
  step "accept the change"
    when == [asked]
    key == ret
    settle == 8
  # NO STEP HERE CLAIMS "THE SWITCH IS ON", AND THAT IS DELIBERATE.
  #
  # The pane's title is "Remote Login" whether the switch is on or off, and the sentence that used to
  # be checked ("log in to this computer") is 15's wording for the ON state and does not appear on
  # this image at all. A check that passes in both states is worse than no check - it reads like
  # evidence and is not.
  #
  # THE PROOF THAT THE SWITCH TOOK IS `wait for sshd` BELOW: sshd is started by that switch and by
  # nothing else, so a port that answers is the state this step cannot fake.
  # THE PANE IS NOT CLOSED: `Done` is at a fixed place only while the pane is in the same state, and
  # nothing after this step needs the window gone. `wait for sshd` reaches the guest over the network,
  # not through Settings.
  step "wait for sshd"
    require_ssh == true
    timeout == 600
  step "prove the build over ssh"
    ssh == sw_vers -productVersion
  step "prove the account over ssh"
    ssh == id -un
  step "prove disk utility works over ssh"
    ssh == diskutil list | head -5
  step "name the machine"
    ssh == printf '%s\n' "{{ password }}" | sudo -S scutil --set LocalHostName {{ user }}
  step "note what is absent"
    ssh == command -v brew || true
  step "stop the machine"
    shutdown == ssh
    timeout == 300
  step "publish the disk"
    compress == '{{ out }}'
